# Database (PostgreSQL — richiesto dallo schema Prisma)
# Locale: postgres://USER:PASSWORD@localhost:5432/dubitor
# Managed: connection string da Neon, Supabase, Railway, …
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dubitor?schema=public"

# Auth.js / NextAuth v5
# AUTH_URL è preferito; NEXTAUTH_URL resta supportato come alias.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Genera con: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"
NEXTAUTH_SECRET="your-random-secret-here"

# Google OAuth (https://console.cloud.google.com/)
# Redirect locale: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Vercel Blob — logo/banner community in produzione
# Locale senza store: gli upload vanno in public/communities/
# Vercel → Storage → Blob → collega lo store al progetto.
# In produzione bastano BLOB_STORE_ID (+ VERCEL_OIDC_TOKEN automatico).
# BLOB_READ_WRITE_TOKEN è solo fallback (locale / fuori Vercel / client upload).
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Super-admin di piattaforma (owner sempre, anche con roster chiusa)
# Lista email separate da virgola — la tua email Google di login
# Sblocca anche /admin (console: utenti, roster, visibilità community)
ORG_ADMIN_EMAILS="tuo@email.com"

# Guardiano: escalate → Slack / Teams (opzionale)
# Senza queste variabili l’escalate resta solo nella demo /guardian.
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_SIGNING_SECRET="..."
# SLACK_CHANNEL_ID="C..."
# TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/..."
# GUARDIAN_RESOLVE_SECRET=""

# Decision API per agenti (Bearer). Senza key → 503 su /api/v1/guardian/*
# GUARDIAN_API_KEY="sk-dev-change-me"
# Oppure più chiavi: GUARDIAN_API_KEYS="sk-a,sk-b"
# In produzione il reset demo è off; forzalo con:
# GUARDIAN_ALLOW_RESET="true"
